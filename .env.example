# ── Environment ───────────────────────────────────────────────────────────────
# SAFETY: tests are blocked on anything other than dev or local
ENV=dev
BASE_URL=https://api.dev.salaryse.com

# ── Auth ──────────────────────────────────────────────────────────────────────
# Phone number of the test user (fills in your dev test account)
TEST_PHONE=
# Fixed dev OTP — do not change unless the dev bypass changes
TEST_OTP=123456

# ── Device headers sent with every request ────────────────────────────────────
TEST_DEVICE_ID=test-automation-device-001
TEST_APP_VERSION=3.5.0
TEST_OS=android

# ── BBPS test data ────────────────────────────────────────────────────────────
# UUID of a biller category in the dev DB  (e.g. Mobile Postpaid)
TEST_BILLER_CATEGORY_REF_ID=

# UUID of a biller in that category  (e.g. Airtel Postpaid)
TEST_BILLER_REF_ID=

# Customer params for the above biller as a JSON object
# e.g. for a mobile-postpaid biller: {"mobileNumber":"9999999999"}
TEST_CUSTOMER_PARAMS={}

# ── Prepaid test data ─────────────────────────────────────────────────────────
# Mobile number to run prepaid plan discovery against
TEST_PREPAID_MOBILE=
# Optionally pin operator / circle to skip auto-detection
TEST_PREPAID_OPERATOR=
TEST_PREPAID_CIRCLE_REF_ID=

# ── UPI test data ─────────────────────────────────────────────────────────────
# VPA sent as the payer in order-creation requests.
# The backend only creates an OrderEntity (PENDING) at this point — no UPI debit
# happens and no SIM binding is required. Any valid-format VPA works.
TEST_UPI_VPA=swiggytest@ypay